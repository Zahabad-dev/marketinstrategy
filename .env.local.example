# Local Development Environment Variables
# Copy this file to .env.local and update with your local values

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Database
DATABASE_URL=mysql://marketuser:marketpass@localhost:3306/marketinstrategy

# JWT Secrets (use different values in production)
JWT_SECRET=local-dev-jwt-secret-key-12345
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=local-dev-refresh-token-secret-67890
REFRESH_TOKEN_EXPIRES_IN=30d

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-nextauth-secret-abcdefg

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Disable email in development
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
