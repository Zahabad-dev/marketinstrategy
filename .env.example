# Database Configuration (MySQL/PostgreSQL)
DATABASE_URL="mysql://user:password@host:3306/database_name"
# Alternativa PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/database_name"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Application Settings
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Upload Configuration
MAX_UPLOAD_SIZE="104857600"
UPLOAD_DIR="./public/uploads"

# External Storage (Opcional - descomentar si usas S3/Cloudinary)
# USE_EXTERNAL_STORAGE="false"
# STORAGE_PROVIDER="S3"

# AWS S3 Configuration (Opcional)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# Cloudinary Configuration (Opcional)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# Email Configuration (Futuro - notificaciones)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Analytics (Opcional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Security
# Cambiar en producción - clave para encriptar datos sensibles
ENCRYPTION_KEY="change-this-to-random-32-char-key"

# Rate Limiting (requests por minuto)
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

# Feature Flags
ENABLE_REGISTRATION="false"
ENABLE_PUBLIC_ACCESS="false"
MAINTENANCE_MODE="false"

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@marketinstrategy.com

# External Services (optional)
# AWS S3 for file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Application Settings
PAGINATION_LIMIT=20
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
